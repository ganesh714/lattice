{
  "name": "lattice",
  "displayName": "Lattice AI",
  "publisher": "lattice-dev",
  "description": "Lattice: A multi-tier agentic AI coding assistant.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:lattice.chatView",
    "onWebviewPanel:lattice.chatView"
  ],
  "contributes": {
    "configuration": {
      "title": "Lattice",
      "properties": {
        "lattice.apiKeys.gemini": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API Key"
        },
        "lattice.apiKeys.groq": {
          "type": "string",
          "default": "",
          "description": "Groq API Key"
        },
        "lattice.local.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama Local Endpoint"
        }
      }
    },
    "viewsContainers": {
      "secondarySideBar": [
        {
          "id": "lattice-sidebar",
          "title": "Lattice",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "lattice-sidebar": [
        {
          "type": "webview",
          "id": "lattice.chatView",
          "name": "Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.0",
    "groq-sdk": "^1.2.0",
    "onnxruntime-node": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.3"
  }
}
